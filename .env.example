# Environment variables are read by Python; this file is an example, not auto-loaded.
SUPPORT_DB=runtime/support.db
SUPPORT_RETRIEVAL=tfidf
# Optional, requires requirements-advanced.txt and a downloaded model:
# SUPPORT_RETRIEVAL=embeddings
# SUPPORT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional OpenAI-compatible Chat Completions provider. Never expose keys in JavaScript.
# SUPPORT_LLM_URL=https://api.openai.com/v1/chat/completions
# SUPPORT_LLM_MODEL=your-model-name
# SUPPORT_LLM_KEY=your-secret
